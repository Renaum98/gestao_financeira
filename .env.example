# Template das variáveis de ambiente. Copie para `.env` e preencha.
# O `.env` é ignorado pelo git; este arquivo existe só pra documentar os nomes.
#
# Os valores do bloco firebaseConfig saem do Console do Firebase →
# ⚙️ Configurações do projeto → Seus apps → app Web.
# São públicos por design: quem controla o acesso são as Security Rules
# (firestore.rules), não a chave.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── App Check (opcional; ver "Proteção contra bot" no README) ───────────────
# Chave de site do reCAPTCHA v3, gerada em Console → App Check → Apps.
# Sem ela o App Check fica desligado e o app roda normalmente.
VITE_FIREBASE_APPCHECK_KEY=

# Só em desenvolvimento, e só se `localhost` NÃO estiver na lista de domínios do
# reCAPTCHA (se estiver, o dev funciona sem isto).
#   true          → o SDK gera um token e imprime no console do navegador;
#                   copie e registre em App Check → Apps → Gerenciar tokens de
#                   depuração.
#   <o token>     → depois de registrado, cole aqui.
# NUNCA preencher isto em produção: é uma chave que dispensa o reCAPTCHA.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
