// Security Rules para o app Finça.
//
// Como publicar:
//   1. Console do Firebase → Firestore Database → Aba "Regras" → cola o conteúdo
//      deste arquivo e clica em "Publicar".
//   2. OU, se você usa Firebase CLI: `firebase deploy --only firestore:rules`
//
// Modelo:
//   users/{uid}                 ← dados pessoais (txs, orçamentos, caixinhas...)
//   userIndex/{emailLower}      ← { uid, nome } pra busca por e-mail
//   partnerships/{pId}          ← (Etapa 4) caixinhas compartilhadas
//   invites/{inviteId}          ← (Etapa 2) convites in-app

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────
    function logado() {
      return request.auth != null;
    }
    function souEu(uid) {
      return logado() && request.auth.uid == uid;
    }
    // Verifica se o usuário autenticado é o parceiro de `uid` (lendo o doc dele).
    // Usado pra liberar a leitura cruzada das txs do parceiro.
    function souParceiroDe(uid) {
      return logado()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.partnerUid == request.auth.uid;
    }

    // ─── users/{uid} ──────────────────────────────────────────────────────
    // Leitura: o dono ou o parceiro vinculado.
    // Escrita: só o dono.
    match /users/{uid} {
      allow read: if souEu(uid) || souParceiroDe(uid);
      allow create: if souEu(uid);
      allow update: if souEu(uid);
      allow delete: if souEu(uid);
    }

    // ─── userIndex/{emailLower} ───────────────────────────────────────────
    // Doc minúsculo com só { uid, nome } pra que um usuário consiga descobrir
    // o uid do parceiro pelo e-mail. Leitura liberada a qualquer autenticado
    // (a privacidade aqui é equivalente a "esse e-mail tem conta?" — qualquer
    // um já descobriria isso tentando criar conta com o mesmo e-mail).
    // Escrita: só quem está autenticado e está gravando o próprio uid.
    match /userIndex/{emailLower} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update: if logado() && resource.data.uid == request.auth.uid;
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }

    // ─── partnerships/{pId} ───────────────────────────────────────────────
    // (Etapa 4) Caixinhas compartilhadas. Ler/escrever só quem está em members.
    match /partnerships/{pId} {
      allow read, update, delete: if logado() && request.auth.uid in resource.data.members;
      // Criação: o criador precisa estar em members.
      allow create: if logado() && request.auth.uid in request.resource.data.members;
    }

    // ─── invites/{inviteId} ───────────────────────────────────────────────
    // (Etapa 2) Convites in-app.
    match /invites/{inviteId} {
      // Lê quem enviou ou quem recebeu.
      allow read: if logado()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      // Cria: precisa estar autenticado e ser o `fromUid` do próprio convite.
      allow create: if logado()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pendente';
      // Atualiza: só o destinatário pode aceitar/recusar.
      allow update: if logado()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pendente'
        && request.resource.data.status in ['aceito', 'recusado'];
      // Deleta: quem enviou (cancelar convite) ou quem recebeu (descartar).
      allow delete: if logado()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }
  }
}
